{
  "name": "curl-sec-analyzer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --tagsFilter=!perf && vitest run --tagsFilter=perf --no-file-parallelism",
    "test:watch": "vitest --tagsFilter=!perf",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit && eslint .",
    "audit": "npm run audit:signatures && npm run audit:deps",
    "audit:signatures": "npm audit signatures",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "screenshot": "vite build && node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "rollup-plugin-license": "^3.7.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "dependencies": {
    "csp_evaluator": "^1.1.8"
  }
}
